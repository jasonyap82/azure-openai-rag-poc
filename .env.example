# ---- Azure OpenAI (required) ----
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
CHAT_DEPLOYMENT=gpt-4o-mini
EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Auth: leave the key BLANK to use Entra ID (DefaultAzureCredential) -- preferred.
# Only set a key if you cannot assign yourself the "Cognitive Services OpenAI User" role.
AZURE_OPENAI_API_KEY=

# ---- Retrieval backend ----
# "local"        -> numpy cosine similarity, zero standing cost (default)
# "azure_search" -> Azure AI Search hybrid + semantic reranking
RETRIEVER=local

AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=rag-poc
AZURE_SEARCH_API_KEY=

# ---- Retrieval / chunking knobs ----
CHUNK_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
TOP_K=4
MIN_RELEVANCE=0.25
